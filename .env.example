# --- Database / broker ---
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5433/citation_db
# Derived automatically from DATABASE_URL when empty (asyncpg -> psycopg)
SYNC_DATABASE_URL=
TEST_DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5433/citation_test
REDIS_PASSWORD=devredispass
REDIS_URL=redis://:devredispass@localhost:6379/0

# --- External API keys (leave empty + USE_MOCK_PROVIDERS=true for local dev) ---
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
# DeepSeek is the only mandatory LLM key: it serves both the classification
# and verification tiers. Gemini is an optional fallback for both tiers when
# DeepSeek is rate-limited or unavailable, and cannot replace DeepSeek on
# its own.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# OpenAlex/Crossref "polite pool" contact email. A real, monitored address
# gets a meaningfully higher rate limit; the shipped default is a
# deliberately-fake example.org placeholder, which reads to OpenAlex's
# abuse detection the same as anonymous/spam traffic -- seen live as an
# 11+ hour hard rate limit on a large batch import. Set this to a real
# inbox before importing a large reference library.
ENRICHMENT_CONTACT_EMAIL=citationinti@example.org

# --- Provider mocking ---
# Master switch: true = no external API calls anywhere (LLM + Scopus mocked).
# When false, missing keys above cause a fail-fast error at startup.
USE_MOCK_PROVIDERS=true
# Optional per-provider overrides (empty = inherit USE_MOCK_PROVIDERS)
MOCK_LLM=
MOCK_SCOPUS=

# --- Local models ---
EMBEDDING_MODEL=allenai/specter2_base
EMBEDDING_USE_ADAPTER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SPACY_MODEL=en_core_web_sm
FORCE_CPU=
# Test-only: replace local models with deterministic fakes (no downloads)
EMBEDDING_FAKE=false
RERANKER_FAKE=false
# Caps torch intra-op parallelism. Left unset torch grabs every core for a
# single matmul, which starves anything else on a shared box. Combined with
# the process-wide inference semaphore (app/core/device.py), peak CPU stays
# near this many cores no matter how many analyses run at once. Raise it to
# trade CPU headroom for faster embedding/reranking.
TORCH_NUM_THREADS=1
# Concurrent analyses. The real value is --concurrency on the worker command
# line in docker-compose.yml; this mirrors it so the CPU budget above can be
# reasoned about in one place.
CELERY_CONCURRENCY=2

# --- LLM pacing (DeepSeek has no hard per-minute token ceiling like Groq's
# free tier did; this is conservative client-side pacing, not a limit
# DeepSeek imposes -- lower it if latency, not throttling, is the bottleneck) ---
# NOTE: this is a *global* floor on the gap between call starts, shared by
# every thread in the worker -- so 1/this is the hard req/s ceiling for the
# whole process. Too high a value throttles LLM_MAX_CONCURRENCY to nothing.
LLM_MIN_SECONDS_BETWEEN_REQUESTS=0.1
LLM_MAX_ATTEMPTS=5
LLM_RETRY_BASE_SECONDS=2.0
LLM_MAX_BACKOFF_SECONDS=60.0
LLM_TIMEOUT_SECONDS=60.0
# In-flight LLM calls per analysis (Tier-1 batches and Tier-2 verifications
# are independent, so they run concurrently). Worst case across the worker
# is CELERY_CONCURRENCY * this. These are network waits, not CPU.
LLM_MAX_CONCURRENCY=10
# Candidates verified with Tier-2 per claim (only the top VERIFY_LIMIT by
# reranker score are checked; fewer LLM calls, and only verified rows are
# ever recommended).
VERIFY_LIMIT=3
CLASSIFY_BATCH_SIZE=25
# How many claims enter retrieval (embedding + vector search + reranking)
# at all, picked by claim confidence. 0 = all. This is the largest CPU
# saving in the pipeline: retrieval used to run over every citation-worthy
# claim and then discard ~85% of that work.
RETRIEVE_CLAIM_LIMIT=40

# --- Misc ---
UPLOAD_DIR=./uploads
CELERY_TASK_ALWAYS_EAGER=false
PYTORCH_ENABLE_MPS_FALLBACK=1
MAX_UPLOAD_MB=25
# JSON array of allowed browser origins for the frontend
CORS_ORIGINS=["http://localhost:3000"]
# Empty = API auth disabled (local dev only). Set to require X-API-Key on every request.
API_KEY=

# --- Server deploy only (docker-compose --profile full), unused by make dev ---
# The Docker network your reverse-proxy container (e.g. Nginx Proxy Manager)
# runs on, so `web` can join it and be reached at http://web:3100 without a
# public port. Check yours with `docker network ls` (Compose auto-names it
# <project-dir>_default). Only matters if your reverse proxy is itself a
# Docker container -- irrelevant if it runs directly on the host.
NPM_NETWORK_NAME=nginx_proxy_manager_default
