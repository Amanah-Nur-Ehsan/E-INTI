# --- Database / broker ---
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5433/citation_db
# Derived automatically from DATABASE_URL when empty (asyncpg -> psycopg)
SYNC_DATABASE_URL=
TEST_DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5433/citation_test
REDIS_PASSWORD=devredispass
REDIS_URL=redis://:devredispass@localhost:6379/0

# --- External API keys (leave empty + USE_MOCK_PROVIDERS=true for local dev) ---
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=
# DeepSeek is the only mandatory LLM key: it serves both the classification
# and verification tiers. Gemini is an optional fallback for both tiers when
# DeepSeek is rate-limited or unavailable, and cannot replace DeepSeek on
# its own.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- Provider mocking ---
# Master switch: true = no external API calls anywhere (LLM + Scopus mocked).
# When false, missing keys above cause a fail-fast error at startup.
USE_MOCK_PROVIDERS=true
# Optional per-provider overrides (empty = inherit USE_MOCK_PROVIDERS)
MOCK_LLM=
MOCK_SCOPUS=

# --- Local models ---
EMBEDDING_MODEL=allenai/specter2_base
EMBEDDING_USE_ADAPTER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SPACY_MODEL=en_core_web_sm
FORCE_CPU=
# Test-only: replace local models with deterministic fakes (no downloads)
EMBEDDING_FAKE=false
RERANKER_FAKE=false

# --- LLM pacing (DeepSeek has no hard per-minute token ceiling like Groq's
# free tier did; this is conservative client-side pacing, not a limit
# DeepSeek imposes -- lower it if latency, not throttling, is the bottleneck) ---
LLM_MIN_SECONDS_BETWEEN_REQUESTS=0.3
LLM_MAX_ATTEMPTS=5
LLM_RETRY_BASE_SECONDS=2.0
LLM_MAX_BACKOFF_SECONDS=60.0
LLM_TIMEOUT_SECONDS=60.0
# Candidates verified with Tier-2 per claim (only the top VERIFY_LIMIT by
# reranker score are checked; fewer LLM calls, and only verified rows are
# ever recommended).
VERIFY_LIMIT=3
CLASSIFY_BATCH_SIZE=10

# --- Misc ---
UPLOAD_DIR=./uploads
CELERY_TASK_ALWAYS_EAGER=false
PYTORCH_ENABLE_MPS_FALLBACK=1
MAX_UPLOAD_MB=25
# JSON array of allowed browser origins for the frontend
CORS_ORIGINS=["http://localhost:3000"]
# Empty = API auth disabled (local dev only). Set to require X-API-Key on every request.
API_KEY=

# --- Server deploy only (docker-compose --profile full), unused by make dev ---
# The Docker network your reverse-proxy container (e.g. Nginx Proxy Manager)
# runs on, so `web` can join it and be reached at http://web:3100 without a
# public port. Check yours with `docker network ls` (Compose auto-names it
# <project-dir>_default). Only matters if your reverse proxy is itself a
# Docker container -- irrelevant if it runs directly on the host.
NPM_NETWORK_NAME=nginx_proxy_manager_default
